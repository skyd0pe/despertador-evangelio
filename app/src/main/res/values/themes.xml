    <style name="AppThemeDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_bg</item>
        <item name="android:colorAccent">#C9A06A</item>
        <item name="android:colorPrimary">#C9A06A</item>
    </style>
</resources>
