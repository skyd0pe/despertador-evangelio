<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Lazarus</string>

    <!-- Los colores reales los pone el código según el tema elegido (Ui.kt → Palette). -->
    <style name="AppThemeLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#7A5528</item>
        <item name="android:colorPrimary">#7A5528</item>
